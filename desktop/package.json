{
  "name": "konectx",
  "version": "3.0.0",
  "description": "Konectx — Controle por gestos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tkfouri/konectx.git"
  },
  "build": {
    "appId": "com.konectx.app",
    "productName": "Konectx",
    "publish": null,
    "win": {
      "target": "nsis"
    },
    "files": [
      "main.js",
      "ui.html",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^41.0.2",
    "electron-builder": "^25.1.8"
  }
}
